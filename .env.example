# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored; never commit real credentials.
# ---------------------------------------------------------------------------

DJANGO_SETTINGS_MODULE=config.settings.dev
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (Supabase free Postgres) -------------------------------------
# Two roles against one database. Create them with scripts/bootstrap_db_roles.sql.
#
# DATABASE_URL      -> autoca_web, via the transaction pooler (port 6543)
# DATABASE_OWNER_URL-> autoca_owner, direct connection (port 5432), migrations only
#
# Supabase free tier: 500MB, and the project PAUSES after 7 days of inactivity.
# scripts/supabase_keepalive.py exists to stop that happening mid-week.
DATABASE_URL=postgresql://autoca_web:PASSWORD@db.PROJECT.supabase.co:6543/postgres
DATABASE_OWNER_URL=postgresql://autoca_owner:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DATABASE_IS_POOLED=1
DATABASE_SSL_REQUIRE=1

# --- Object storage (Cloudflare R2) ----------------------------------------
# Free: 10GB, 1M writes / 10M reads per month, zero egress.
STORAGE_BACKEND=integrations.storage.r2.R2StorageAdapter
STORAGE_BUCKET=autoca-dev
STORAGE_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# At beta, the entire storage migration is these three lines:
#   STORAGE_BACKEND=integrations.storage.s3.S3StorageAdapter
#   STORAGE_REGION=ap-south-1
#   STORAGE_ENDPOINT_URL=

# --- Queue / cache (Upstash Redis) -----------------------------------------
# Free: 500K commands/month, 256MB. Upstash requires TLS, so rediss://.
QUEUE_BACKEND=integrations.queue.celery_redis.CeleryRedisQueueAdapter
CELERY_BROKER_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
CELERY_BROKER_USE_SSL=1

# --- KMS -------------------------------------------------------------------
# Dev only. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KMS_BACKEND=integrations.kms.local_fernet.LocalFernetKMSAdapter
KMS_LOCAL_MASTER_KEY=

# --- OCR -------------------------------------------------------------------
# Stub only, and deliberately so. Do NOT point this at Azure Document
# Intelligence F0: that tier silently processes only the first 2 pages of any
# document. See integrations/ocr/base.py.
OCR_BACKEND=integrations.ocr.stub.StubOCRAdapter

# --- LLM -------------------------------------------------------------------
# Not wired this phase.
LLM_BACKEND=integrations.llm.stub.StubLLMAdapter

OTP_TOTP_ISSUER=AutoCA
LOG_LEVEL=INFO
