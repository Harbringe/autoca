# Copy this to .env.live in the project root (git ignores it) and fill in the blanks. Never commit it, paste it into a chat, or
# put it anywhere that syncs. It holds the keys that unlock every client's books.
#
# Where the values are: on the server, in .env.prod. Read them through a Session Manager shell
# (aws ssm start-session --target <instance>), not by copying the file. docs/LIVE.md says which line is which.

# The tunnel from scripts\live-tunnel.ps1 ends at localhost:5433. Use the app role's login (the DATABASE_URL line of .env.prod),
# with the host changed to 127.0.0.1:5433 (not "localhost": that can resolve to IPv6 first, where the tunnel does not listen,
# and Django then waits forever). Not the owner's, not the superuser's.
DATABASE_URL=postgresql://autoca_web:PASSWORD@127.0.0.1:5433/autoca
# The tunnel is already encrypted end to end; the database container itself speaks plain Postgres.
DATABASE_SSL_REQUIRE=0

# These two decrypt what is stored (names, GSTINs, bank account numbers) and find rows by identifier. The same values as the
# server, or every encrypted field is unreadable here. They are the most sensitive thing on this PC.
KMS_BACKEND=integrations.kms.local_fernet.LocalFernetKMSAdapter
KMS_LOCAL_MASTER_KEY=
BLIND_INDEX_KEY=

# Signs sessions. Any value works here (it does not have to match the server's); leave a throwaway.
DJANGO_SECRET_KEY=local-only-throwaway

# --- Optional: turn on the real model, the real bucket, the assistant -------------------------------------------------------
# All three are OFF unless set to 1. Off means a stub model and a storage adapter that refuses, whatever the project's own .env
# holds. ON IS REAL: files are written to and deleted from the live bucket, and real rows are sent to the model provider.
# Each one needs the settings the server has, copied from .env.prod through a shell, never pasted into a chat.
#
# The model: also set LLM_BACKEND and the key (LLM_API_KEY, or GROQ_API_KEY), LLM_MODEL, and VISION_READING as on the server.
LIVE_ALLOW_MODEL=0
# The bucket: also set STORAGE_BACKEND=integrations.storage.s3.S3StorageAdapter, STORAGE_BUCKET and STORAGE_REGION. The credentials
# are your own AWS login (the one `aws configure` set up), which needs s3:GetObject, s3:PutObject, s3:DeleteObject on the bucket.
LIVE_ALLOW_STORAGE=0
# The assistant worker (`manage.py run_assistant`): reads waiting rows and sends them to the model. Needs LIVE_ALLOW_MODEL too.
LIVE_ALLOW_ASSISTANT=0

# Real sign-in, real second factor.
MFA_DISABLED=0
