# Settings for compose.prod.yaml. Copy to .env.prod on the server and fill in. Never commit .env.prod.
#
# Do NOT generate new secrets for a deployment that already has data. Copy these EXACTLY from the
# running deployment's environment (the Render dashboard -> Environment):
#
#   KMS_LOCAL_MASTER_KEY  every stored bank account number is encrypted under it. A different value
#                         makes them unreadable.
#   BLIND_INDEX_KEY       the lookup column beside each encrypted identifier. A different value
#                         makes every existing account unfindable.
#   DJANGO_SECRET_KEY     signs sessions and tokens. A different value signs everyone out, which is
#                         harmless but surprising.
#   DATABASE_*            the same database the live app uses, until the database itself is moved.
#
# Keep a copy of these in a password manager. Losing the first two loses the stored account numbers.

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
# The name this server answers to; Caddy gets its certificate for it. DNS must already point at the
# server (an A record), or the certificate request fails.
API_HOST=
# The same name for Django (comma-separated if it ever answers to more than one).
DJANGO_ALLOWED_HOSTS=
# The address of the web app the browser loads (Vercel). Invitation links and the CSRF origin use it.
FRONTEND_URL=
# Extra origins allowed to send the session cookie, comma-separated. Usually the same as FRONTEND_URL.
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=
DATABASE_OWNER_URL=
DATABASE_IS_POOLED=1
DATABASE_SSL_REQUIRE=1

# Files go to S3. There are deliberately NO access-key settings: the server's IAM role signs the
# requests, so there is no key to store, leak or rotate. Leave STORAGE_ENDPOINT_URL unset.
STORAGE_BACKEND=integrations.storage.s3.S3StorageAdapter
STORAGE_BUCKET=
STORAGE_REGION=ap-south-1

QUEUE_BACKEND=integrations.queue.celery_redis.CeleryRedisQueueAdapter
CELERY_BROKER_URL=

KMS_BACKEND=integrations.kms.local_fernet.LocalFernetKMSAdapter
KMS_LOCAL_MASTER_KEY=
BLIND_INDEX_KEY=

LLM_BACKEND=integrations.llm.groq.GroqLLMAdapter
GROQ_API_KEY=
GROQ_MODEL=
LLM_BATCH_SIZE=25
LLM_SHARE_BUSINESS_NAMES=true

OTP_TOTP_ISSUER=AutoCA
LOG_LEVEL=INFO

# Proxies between the browser and the app that are trusted to set X-Forwarded-For. One for Caddy or
# nginx alone; two when CloudFront sits in front of nginx. Too low blames the proxy for every
# request; too high lets a client choose its own address.
TRUSTED_PROXY_COUNT=1
