# Settings for compose.prod.yaml. deploy/init-env.sh turns this into .env.prod on the server. Never commit
# .env.prod.
#
# A NEW deployment has its three secrets generated by init-env.sh. For a deployment that already has data,
# run it with --carry-secrets and copy these EXACTLY from the running deployment's environment (the Render
# dashboard -> Environment):
#
#   KMS_LOCAL_MASTER_KEY  every stored bank account number is encrypted under it. A different value
#                         makes them unreadable.
#   BLIND_INDEX_KEY       the lookup column beside each encrypted identifier. A different value
#                         makes every existing account unfindable.
#   DJANGO_SECRET_KEY     signs sessions and tokens. A different value signs everyone out, which is
#                         harmless but surprising.
#   DATABASE_*            the same database the live app uses, until the database itself is moved.
#
# Keep a copy of these in a password manager. Losing the first two loses the stored account numbers.

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
# The two names this server answers to, both serving the web app and the API on one origin. Caddy gets a
# certificate for each. DNS must already point both at the server (A records), or the request fails.
# APP_HOST is the one people use.
APP_HOST=
API_HOST=
# The same two names for Django.
DJANGO_ALLOWED_HOSTS=
# The address of the web app the browser loads. Invitation links and the CSRF origin use it.
FRONTEND_URL=
# Origins allowed to send the session cookie, comma-separated: the same names, with https://.
CSRF_TRUSTED_ORIGINS=

# The database runs beside the app (the `db` service). deploy/init-env.sh generates the app role's login
# and fills it in. The OWNER role's login is deliberately not here: it lives in .env.owner, which only the
# migrate step reads, so a compromised web process cannot change the schema.
# To use an external database (RDS, Supabase) instead, set DATABASE_URL by hand, set SSL_REQUIRE=1 (and
# POOLED=1 behind a transaction pooler), and remove the `db` service from compose.
DATABASE_URL=
DATABASE_IS_POOLED=0
DATABASE_SSL_REQUIRE=0

# Files go to S3. There are deliberately NO access-key settings: the server's IAM role signs the
# requests, so there is no key to store, leak or rotate. Leave STORAGE_ENDPOINT_URL unset.
STORAGE_BACKEND=integrations.storage.s3.S3StorageAdapter
STORAGE_BUCKET=
STORAGE_REGION=ap-south-1

# The bucket the nightly database dump goes to (deploy/backup.sh, docs/AWS.md). A separate bucket from the files on
# purpose: the server's role may write and list it but never read or delete, so a compromised server can neither
# read the dumps nor erase them. Restores attach a temporary read policy (docs/AWS.md).
BACKUP_BUCKET=

QUEUE_BACKEND=integrations.queue.celery_redis.CeleryRedisQueueAdapter
CELERY_BROKER_URL=

KMS_BACKEND=integrations.kms.local_fernet.LocalFernetKMSAdapter
KMS_LOCAL_MASTER_KEY=
BLIND_INDEX_KEY=

LLM_BACKEND=integrations.llm.groq.GroqLLMAdapter
GROQ_API_KEY=
GROQ_MODEL=
# Any provider. LLM_API_KEY, LLM_MODEL and LLM_BASE_URL may be kept in AWS Parameter Store instead: see docs/SECRETS.md.
# To use OpenAI: LLM_BACKEND=integrations.llm.openai.OpenAILLMAdapter and LLM_MODEL=gpt-6-luna.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# Reading scanned statements by their page images. Off until a firm decides page images may go to the provider.
VISION_READING=false

# Debug archive: off unless you do the setup in docs/DEBUG_ARCHIVE.md first (its own bucket, 10-day expiry, server may only write).
# While on, every uploaded file's text and every model reply is filed there. Leave off in production unless you are debugging.
DEBUG_ARCHIVE_ENABLED=false
DEBUG_ARCHIVE_BUCKET=
DEBUG_ARCHIVE_REGION=ap-south-1
DEBUG_ARCHIVE_PREFIX=dev
LLM_BATCH_SIZE=25
LLM_SHARE_BUSINESS_NAMES=true

OTP_TOTP_ISSUER=AutoCA
LOG_LEVEL=INFO

# Proxies between the browser and the app that are trusted to set X-Forwarded-For. One for Caddy or
# nginx alone; two when CloudFront sits in front of nginx. Too low blames the proxy for every
# request; too high lets a client choose its own address.
TRUSTED_PROXY_COUNT=1
